# Required in production. Used to encrypt API keys and notification tokens.
APP_SECRET=change_this_to_a_long_random_string

# SQLite database directory. Use an absolute path on VPS.
DATA_DIR=/var/lib/worldcup-predict

# Protects /api/cron/daily-brief. Use a long random value.
CRON_SECRET=change_this_cron_secret

# Optional: enable AI summaries in scheduled daily pushes.
PUSH_INCLUDE_AI=0

# Optional: send "no matches tomorrow" messages.
PUSH_EMPTY_DAYS=0

# MiniMax domestic endpoint fallback. Admin UI settings override these when enabled.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_MODEL=MiniMax-Text-01

# Xiaomi MiMo OpenAI-compatible fallback/preset. Confirm your official endpoint in MiMo console.
XIAOMI_MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1
XIAOMI_MIMO_MODEL=mimo-v2.5-pro
